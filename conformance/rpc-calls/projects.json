[
  { "tag": "projects.listEntries", "payload": { "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "projects.listEntries", "payload": { "cwd": "$WORKSPACE", "directoryPath": "" }, "expect": "success" },
  { "tag": "projects.listEntries", "payload": { "cwd": "/definitely/missing" }, "expect": "failure", "error": "ProjectListEntriesError" },
  { "tag": "projects.listEntries", "payload": { "cwd": "$WORKSPACE", "directoryPath": "../" }, "expect": "failure", "error": "ProjectListEntriesError" },
  { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "projects.searchEntries", "payload": { "cwd": "$WORKSPACE", "query": "@calc", "limit": 20 }, "expect": "success" },
  { "tag": "projects.searchEntries", "payload": { "cwd": "$WORKSPACE", "query": "", "limit": 5, "kind": "file", "imageOnly": true }, "expect": "success" },
  { "tag": "projects.searchEntries", "payload": { "cwd": "/definitely/missing", "query": "x", "limit": 5 }, "expect": "failure", "error": "ProjectSearchEntriesError" },
  { "tag": "projects.searchContents", "payload": { "cwd": "$WORKSPACE", "query": "return", "limit": 20, "caseSensitive": false, "wholeWord": true, "useRegex": false }, "expect": "success" },
  { "tag": "projects.searchContents", "payload": { "cwd": "$WORKSPACE", "query": "add(", "limit": 20, "caseSensitive": false, "wholeWord": false, "useRegex": true }, "expect": "success" },
  { "tag": "projects.searchContents", "payload": { "cwd": "/definitely/missing", "query": "x", "limit": 5, "caseSensitive": false, "wholeWord": false, "useRegex": false }, "expect": "failure", "error": "ProjectSearchContentsError" },
  { "tag": "projects.writeFile", "payload": { "cwd": "$WORKSPACE", "relativePath": "notes/todo.md", "contents": "- [ ] test\n" }, "expect": "success" },
  { "tag": "projects.writeFile", "payload": { "cwd": "$WORKSPACE", "relativePath": "../escape.md", "contents": "x" }, "expect": "failure", "error": "ProjectWriteFileError" },
  { "tag": "projects.writeFile", "payload": { "cwd": "/tmp", "relativePath": "x.md", "contents": "x" }, "expect": "failure", "error": "ProjectWriteFileError" },
  { "tag": "projects.readFile", "payload": { "cwd": "$WORKSPACE", "relativePath": "notes/todo.md" }, "expect": "success" },
  { "tag": "filesystem.getMetadata", "payload": { "paths": ["$WORKSPACE/calc.py", "$WORKSPACE", "relative.txt", "/definitely/missing"] }, "expect": "success" },
  { "tag": "attachments.createUploadUrl", "payload": { "name": "shot.png", "mimeType": "image/png", "sizeBytes": 3 }, "expect": "success" },
  { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "notes.txt", "mimeType": "text/plain", "sizeBytes": 10 }, "expect": "success" },
  { "tag": "attachments.delete", "payload": { "attachmentId": "pending-00000000-0000-4000-8000-000000000000" }, "expect": "success" },
  { "tag": "assets.persistChatAttachments", "payload": { "threadId": "$THREAD", "messageId": "m2", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "success" },
  { "tag": "assets.persistChatAttachments", "payload": { "threadId": "$THREAD", "messageId": "m2", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 9, "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError" },
  { "tag": "projects.mutate", "payload": { "type": "project.update", "commandId": "u1", "projectId": "$PROJECT", "title": "Calculator", "pinned": true, "projectIcon": { "kind": "emoji", "emoji": "🧮" } }, "expect": "success" },
  { "tag": "projects.mutate", "payload": { "type": "project.update", "commandId": "u2", "projectId": "nope", "title": "x" }, "expect": "failure", "error": "ProjectMutationError" },
  { "tag": "projects.ensureScratch", "payload": {}, "expect": "success" },
  { "tag": "projects.createNew", "payload": { "name": "Fresh Idea" }, "expect": "success" },
  { "tag": "projects.createFromThread", "payload": { "threadId": "$THREAD" }, "expect": "failure", "error": "OrchestrationDispatchCommandError" }
]
