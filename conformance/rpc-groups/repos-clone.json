{
  "cases": [
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/by-url" }, "note": "a URL alone: no repository in the answer" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/empty" }, "note": "a path as the URL, into a folder that exists and is empty" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://user:secret@localhost$DIR/remotes/acme/local.git", "destinationPath": "~/clones/tilde" }, "note": "credentials are not in the answer's URL; ~ is the home folder; the parent folder is made" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/a/../dotdot" }, "note": "the destination is resolved" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/by-ssh-url" }, "note": "over (stand-in) ssh" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/local", "destinationPath": "$DIR/clones/by-name" }, "note": "a repository by name: looked up with gh, cloned from its ssh URL" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/local", "protocol": "https", "destinationPath": "$DIR/clones/by-name-https" }, "note": "from its https URL" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/local", "protocol": "ssh", "destinationPath": "$DIR/clones/by-name-ssh" } },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/local", "protocol": "auto", "remoteUrl": "file://$DIR/remotes/acme/nope.git", "destinationPath": "$DIR/clones/by-name-over-url" }, "note": "a repository by name wins over a URL" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/denied", "protocol": "auto", "destinationPath": "$DIR/clones/fallback-by-name" }, "note": "ssh refuses the key: cloned from the repository's https URL instead" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/denied", "protocol": "ssh", "destinationPath": "$DIR/clones/no-fallback" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "ssh asked for: no fallback" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/hostkey", "destinationPath": "$DIR/clones/fallback-fails" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "ssh refuses the host key and the https URL fails too" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@denied.test:acme/local.git", "destinationPath": "$DIR/clones/fallback-by-url" }, "note": "ssh refuses the key: the https form of the URL is cloned" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "ssh://git@denied.test/acme/local.git", "destinationPath": "$DIR/clones/fallback-by-ssh-scheme" } },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@denied.test:acme/local.git", "protocol": "ssh", "destinationPath": "$DIR/clones/no-fallback-by-url" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@hostkey.test:acme/gone.git", "destinationPath": "$DIR/clones/fallback-fails-by-url" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@echo.test:acme/x.git", "destinationPath": "$DIR/clones/echo" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "credentials in what git prints are not in the failure" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "git@nowhere.test:acme/x.git", "destinationPath": "$DIR/clones/unresolved" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/nope.git", "destinationPath": "$DIR/clones/bad-url" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "no repository at the URL" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "gitlab", "remoteUrl": "file://$DIR/remotes/acme/nope.git", "destinationPath": "$DIR/clones/bad-url-gitlab" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the failure names the provider given" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "not a url", "destinationPath": "$DIR/clones/not-a-url" }, "expect": "failure", "error": "SourceControlRepositoryError" },

    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "unknown", "repository": "acme/local", "destinationPath": "$DIR/clones/lookup-unknown" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "gitlab", "repository": "acme/local", "destinationPath": "$DIR/clones/lookup-gitlab" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/missing", "destinationPath": "$DIR/clones/lookup-missing" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "gh: repository not found" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/loggedout", "destinationPath": "$DIR/clones/lookup-loggedout" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "gh: not logged in" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/garbled", "destinationPath": "$DIR/clones/lookup-garbled" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/partial", "destinationPath": "$DIR/clones/lookup-partial" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "gh gives no ssh URL: nothing to clone" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/partial", "protocol": "https", "destinationPath": "$DIR/clones/lookup-partial-https" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "gh gives no https URL: nothing to clone" },
    { "sh": "mv bin/gh bin/gh.off", "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "repository": "acme/local", "destinationPath": "$DIR/clones/lookup-no-gh" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "no gh on PATH" },
    { "sh": "mv bin/gh.off bin/gh", "tag": "sourceControl.cloneRepository", "payload": { "destinationPath": "$DIR/clones/no-url" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "nothing to clone" },
    { "tag": "sourceControl.cloneRepository", "payload": { "provider": "github", "destinationPath": "$DIR/clones/no-url-github" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "a provider without a repository: nothing to clone, the failure names the provider" },
    { "tag": "sourceControl.cloneRepository", "payload": { "repository": "acme/local", "destinationPath": "$DIR/clones/no-provider" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "a repository without a provider is not looked up" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "  ", "destinationPath": "$DIR/clones/blank-url" }, "expect": "failure", "error": "SourceControlRepositoryError", "skip_schema": true, "note": "the payload is outside the schema (a blank URL) on purpose: the server takes it as none" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": " file://$DIR/remotes/acme/local.git ", "destinationPath": " $DIR/clones/padded " }, "skip_schema": true, "note": "the payload is outside the schema (not trimmed) on purpose: the server trims both" },

    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "  " }, "expect": "failure", "error": "SourceControlRepositoryError", "skip_schema": true, "note": "the payload is outside the schema (a blank destination) on purpose: the only way to this failure" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/afile" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination is a file" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/full" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination has files" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/by-url" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination is an earlier clone" },
    { "tag": "sourceControl.cloneRepository", "payload": { "remoteUrl": "file://$DIR/remotes/acme/local.git", "destinationPath": "$DIR/clones/afile/sub/dest" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination's parent cannot be made" }
  ]
}
