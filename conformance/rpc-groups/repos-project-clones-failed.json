{
  "cases": [
    { "tag": "projectClone.start", "payload": { "projectId": "pf-bad", "title": "Not there yet", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/later.git", "destinationPath": "$DIR/clones/f-bad" }, "note": "no repository at the URL: the start succeeds, the clone fails" },
    { "sh": "await-ssh github.test 1 && await-exit f-bad", "sleep_ms": 700, "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "the clone has failed" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pf-bad" }, "note": "a clone that has failed is not cancelled" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-bad", "title": "Again", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/f-bad-2" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the project has a clone" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-dup", "title": "Same folder", "createdAt": "2026-01-01T00:00:00.000Z", "provider": "gitlab", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/f-bad" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the folder has a clone; the failure names the provider given" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-e1", "title": "Nothing", "createdAt": "2026-01-01T00:00:00.000Z", "destinationPath": "$DIR/clones/f-e1" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "nothing to clone" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-e2", "title": "Full", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/full" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination has files" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-e3", "title": "Missing", "createdAt": "2026-01-01T00:00:00.000Z", "provider": "github", "repository": "acme/missing", "destinationPath": "$DIR/clones/f-e3" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "gh: repository not found" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-e4", "title": "Unknown", "createdAt": "2026-01-01T00:00:00.000Z", "provider": "unknown", "repository": "acme/local", "destinationPath": "$DIR/clones/f-e4" }, "expect": "failure", "error": "SourceControlRepositoryError" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-e5", "title": "Blank", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": " " }, "expect": "failure", "error": "SourceControlRepositoryError", "skip_schema": true, "note": "the payload is outside the schema (a blank destination) on purpose: the only way to this failure" },
    { "sh": "mkdir -p clones/locked && chmod 555 clones/locked", "tag": "projectClone.start", "payload": { "projectId": "pf-locked", "title": "Locked", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/locked/sub" }, "expect": "failure", "error": "OrchestrationDispatchCommandError", "note": "the project's folder cannot be made" },
    { "sh": "chmod 755 clones/locked", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "none of the refused starts is listed" },

    { "tag": "projectClone.retry", "payload": { "projectId": "pf-bad" }, "note": "a failed clone is tried again" },
    { "sh": "await-ssh github.test 2 && await-exit f-bad", "sleep_ms": 700, "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "and has failed again" },
    { "sh": "mkdir -p clones/f-bad && echo stray > clones/f-bad/stray.txt", "tag": "projectClone.retry", "payload": { "projectId": "pf-bad" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination has files that are not a clone's" },
    { "sh": "rm -r clones/f-bad && echo file > clones/f-bad", "tag": "projectClone.retry", "payload": { "projectId": "pf-bad" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination is a file" },
    { "sh": "rm clones/f-bad && chmod 555 clones", "tag": "projectClone.retry", "payload": { "projectId": "pf-bad" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the destination cannot be made again" },
    { "sh": "chmod 755 clones", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "the refused retries changed nothing" },

    { "tag": "projectClone.start", "payload": { "projectId": "pf-recv", "title": "Stops while receiving", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@receiving.says.test:acme/x.git", "protocol": "ssh", "destinationPath": "$DIR/clones/f-recv" } },
    { "sh": "await-ssh receiving.says.test && await-exit f-recv", "sleep_ms": 700, "tag": "projectClone.start", "payload": { "projectId": "pf-long", "title": "Says a lot", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@long.says.test:acme/x.git", "destinationPath": "$DIR/clones/f-long" } },
    { "sh": "await-ssh long.says.test && await-exit f-long", "sleep_ms": 700, "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "failed clones keep the stage, percent and detail they reached; a long detail and a long error are cut" },

    { "tag": "projectClone.start", "payload": { "projectId": "pr-slow", "title": "Never answers", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@slow.test:acme/x.git", "destinationPath": "$DIR/clones/f-slow" } },
    { "sh": "await-ssh slow.test", "tag": "projectClone.start", "payload": { "projectId": "pr-count", "title": "Stops while counting", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@counting-hang.says.test:acme/x.git", "destinationPath": "$DIR/clones/f-count" } },
    { "sh": "await-ssh counting-hang.says.test", "sleep_ms": 700, "tag": "projectClone.start", "payload": { "projectId": "pr-resolve", "title": "Stops while resolving", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@resolving-hang.says.test:acme/x.git", "destinationPath": "$DIR/clones/f-resolve" } },
    { "sh": "await-ssh resolving-hang.says.test", "sleep_ms": 700, "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "three clones are running: connecting, counting at 50%, resolving with a line that has no percent" },
    { "tag": "projectClone.retry", "payload": { "projectId": "pr-slow" }, "note": "a running clone is not retried" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pr-slow" }, "note": "a running clone is cancelled" },
    { "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "cancelled" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pr-slow" }, "note": "a cancelled clone is not cancelled again" },
    { "tag": "projectClone.retry", "payload": { "projectId": "pr-slow" }, "note": "a cancelled clone is tried again" },
    { "sh": "await-ssh slow.test 2", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "running again" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pr-slow" } },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pr-count" } },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pr-resolve" } },
    { "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "all three cancelled, each with the stage it had reached" },

    { "tag": "projects.mutate", "payload": { "type": "project.update", "commandId": "c-move", "projectId": "pf-recv", "workspaceRoot": "$DIR/clones/moved" }, "note": "the project of a failed clone moves to another folder" },
    { "tag": "projectClone.start", "payload": { "projectId": "pf-new", "title": "Into the moved project", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/moved" }, "expect": "failure", "error": "SourceControlRepositoryError", "note": "the project on that folder would take the clone, and has one" },
    { "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "the refused start is not listed" },

    { "sh": "git clone -q --bare seed remotes/acme/later.git", "tag": "projectClone.retry", "payload": { "projectId": "pf-bad" }, "note": "the repository is there now" },
    { "sh": "await-done pf-bad", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "the retried clone is done" },
    { "http": "GET /api/orchestration/shell", "status": 200, "note": "a project for every clone that started; only the one that was cloned has its repository" }
  ]
}
