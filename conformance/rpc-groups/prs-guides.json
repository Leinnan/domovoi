    {"tag": "pullRequests.generateReviewGuide", "payload": {"projectId": "$PROJECT", "repository": "acme/calc", "number": 13}, "sh": "gh-rule err '.' 'To get started with GitHub CLI, please run:  gh auth login'", "expect": "failure", "error": "PullRequestUnavailableError"},
    {"tag": "pullRequests.reviewGuide", "payload": {"projectId": "$PROJECT", "repository": "acme/calc", "number": 7}, "sh": "gh-rule clear && mkdir -p home/userdata/review-guides && cp gh-data/stored-guide.json home/userdata/review-guides/github.com__acme_calc__7.json", "note": "a guide found on disk"},
    {"tag": "pullRequests.generateReviewGuide", "payload": {"projectId": "$PROJECT", "repository": "acme/calc", "number": 7}, "note": "it covers the head"},
