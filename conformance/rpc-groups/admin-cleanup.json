{ "env": {"DOMOVOI_CLAUDE_BINARY": "$DIR/bin/claude"},
  "normalize": [["/p{5,}/", "/<pad>/"]],
  "cases": [
    {"tag": "projects.mutate", "payload": {"type": "project.create", "commandId": "create-project", "projectId": "project-c", "title": "repo", "workspaceRoot": "$DIR/repo", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "no thread has a worktree: an old log goes, a folder of nobody's stays"},
    {"tag": "server.getStorageCleanupReport", "payload": {}, "expect": "chunk", "note": "the last report"},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-a", "creationSource": "web", "threadId": "thread-a", "projectId": "project-c", "title": "Plain", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTA": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-b", "creationSource": "web", "threadId": "thread-b", "projectId": "project-c", "title": "Settled", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTB": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-c", "creationSource": "web", "threadId": "thread-c", "projectId": "project-c", "title": "Archived", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTC": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-d", "creationSource": "web", "threadId": "thread-d", "projectId": "project-c", "title": "Deleted", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTD": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-e", "creationSource": "web", "threadId": "thread-e", "projectId": "project-c", "title": "Locked", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTE": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-f", "creationSource": "web", "threadId": "thread-f", "projectId": "project-c", "title": "Broken", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}}, "save": {"WTF": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.settle", "commandId": "thread.settle-b", "threadId": "thread-b"}},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.archive", "commandId": "thread.archive-c", "threadId": "thread-c"}},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.delete", "commandId": "thread.delete-d", "threadId": "thread-d"}},
    {"sh": "git -C repo worktree lock \"$WTE\" && echo garbage > \"$WTF/.git\"", "tag": "server.runStorageCleanup", "payload": {}, "note": "default rules: no rule removes a worktree; one that cannot be inspected says so; a deleted thread's is nobody's"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeSettledAfterDays": 7}}}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "settled for 0 of 7 days, the others not settled"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeSettledAfterDays": null, "worktreeAfterDays": 30}}}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "a rule there is, which applies to none yet"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeAfterDays": null, "worktreeSettledAfterDays": 0, "logsAfterDays": 1}}}},
    {"sh": "echo x > \"$WTB/scratch.txt\" && ./old-log three-days.log 3 12345 && chmod a-w home/userdata/logs", "tag": "server.runStorageCleanup", "payload": {}, "note": "the settled one may go but has local changes; a log three days old is due under a one-day rule but cannot be removed: failed"},
    {"sh": "chmod u+w home/userdata/logs && git -C \"$WTB\" add -A && git -C \"$WTB\" -c user.name=t -c user.email=t@t commit -qm local", "tag": "server.runStorageCleanup", "payload": {}, "note": "its changes committed: commits neither pushed nor in the project checkout; the log goes"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeKeepWhen": "tracked-changes"}}}},
    {"sh": "git -C \"$WTB\" reset -q --hard HEAD~1 && echo x > \"$WTB/scratch.txt\"", "tag": "server.runStorageCleanup", "payload": {}, "note": "under tracked-changes an untracked file does not keep it: removed"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeSettledAfterDays": null, "worktreeUnchanged": true, "worktreeKeepWhen": "any-local-files"}}}},
    {"sh": "echo ignored.tmp >> repo/.git/info/exclude && echo x > \"$WTC/ignored.tmp\"", "tag": "server.runStorageCleanup", "payload": {}, "note": "archived and unchanged may go, but any-local-files keeps it for an ignored file"},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeKeepWhen": "uncommitted-changes", "worktreeOnDelete": true}}}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "an ignored file does not keep it under uncommitted-changes: removed"},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.settle", "commandId": "thread.settle-e", "threadId": "thread-e"}},
    {"tag": "server.updateSettings", "payload": {"patch": {"storageCleanup": {"worktreeUnchanged": false, "worktreeOnDelete": false, "worktreeSettledAfterDays": 0}}}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "the locked worktree may go but git refuses: failed, with git's words"},
    {"sleep_ms": 30, "tag": "orchestration.launchThread", "payload": {"commandId": "launch-h", "creationSource": "web", "threadId": "thread-h", "projectId": "project-c", "title": "Shares A's worktree", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "existing_worktree", "worktreePath": "$WTA"}}, "save": {"WTH": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.settle", "commandId": "thread.settle-h", "threadId": "thread-h"}},
    {"tag": "server.runStorageCleanup", "payload": {}, "note": "two threads in one worktree: the newer one decides, and it is settled: removed"},
    {"sleep_ms": 30, "sh": "touch claude-hangs", "tag": "orchestration.launchThread", "payload": {"commandId": "launch-g", "creationSource": "web", "threadId": "thread-g", "projectId": "project-c", "title": "At work", "modelSelection": {"instanceId": "claudeAgent", "model": "claude-haiku-5-5"}, "runtimeMode": "approval-required", "interactionMode": "default", "workspaceStrategy": {"type": "worktree", "baseRef": "main"}, "initialMessage": {"messageId": "m-g", "text": "hello", "attachments": []}}, "save": {"WTG": "/projection/thread/worktreePath"}},
    {"sleep_ms": 30, "tag": "orchestration.dispatchCommand", "payload": {"type": "thread.settle", "commandId": "thread.settle-g", "threadId": "thread-g"}},
    {"sh": "sleep 0.5", "tag": "server.runStorageCleanup", "payload": {}, "note": "an agent at work keeps its worktree whatever the rules"},
    {"tag": "server.getStorageCleanupReport", "payload": {}, "expect": "chunk"}
  ] }
