   "sh": "sqlite3 home/userdata/domovoi.sqlite 'DROP TRIGGER IF EXISTS refuse; ALTER TABLE scheduled_tasks RENAME TO scheduled_tasks_away'"
  },
  {
   "tag": "scheduledTasks.setEnabled",
   "payload": {
    "id": "task-a",
    "enabled": true
   },
   "note": "nor a task loaded",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Hourly check",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "interval",
     "everyMs": 3600000
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
     "model": "claude-haiku-5-5"
    },
    "runtimeMode": "approval-required",
    "interactionMode": "default",
    "id": "task-b"
   },
   "note": "nor looked up for a save",
   "expect": "failure",
   "error": "ScheduledTaskError"
