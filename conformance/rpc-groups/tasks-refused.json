  {
   "tag": "scheduledTasks.runNow",
   "payload": {
    "id": "task-a"
   },
   "note": "nothing to mark as running",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Hook",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "webhook"
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
     "model": "claude-haiku-5-5"
    },
    "runtimeMode": "approval-required",
    "interactionMode": "default",
    "id": "hook-a"
   },
   "note": "nothing saved",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Bound",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "interval",
     "everyMs": 3600000
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
