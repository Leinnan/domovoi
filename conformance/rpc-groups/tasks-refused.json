{
 "fixture": true,
 "env": {
  "TZ": "Europe/Berlin"
 },
 "normalize": [
  [
   "/api/hooks/([^/]+)/[A-Za-z0-9_-]{43}",
   "/api/hooks/${1}/<token>"
  ],
  [
   "^(claude|codex) initialize failed: .*$",
   "${1} initialize failed: <how>"
  ]
 ],
 "cases": [
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Hourly check",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "interval",
     "everyMs": 3600000
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
     "model": "claude-haiku-5-5"
    },
    "runtimeMode": "approval-required",
    "interactionMode": "default",
    "id": "task-a"
   },
   "note": "setup: a task"
  },
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Hook",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "webhook"
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
     "model": "claude-haiku-5-5"
    },
    "runtimeMode": "approval-required",
    "interactionMode": "default",
    "id": "hook-a"
   },
   "note": "setup: a webhook task"
  },
  {
   "tag": "scheduledTasks.setEnabled",
   "payload": {
    "id": "task-a",
    "enabled": false
   },
   "note": "the row cannot be updated",
   "expect": "failure",
   "error": "ScheduledTaskError",
   "sh": "sqlite3 home/userdata/domovoi.sqlite \"DROP TRIGGER IF EXISTS refuse; CREATE TRIGGER refuse BEFORE UPDATE ON scheduled_tasks  BEGIN SELECT RAISE(ABORT, 'refused by the test'); END\""
  },
  {
   "tag": "scheduledTasks.rotateWebhookToken",
   "payload": {
    "id": "hook-a"
   },
   "note": "nor its token replaced",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.runNow",
   "payload": {
    "id": "task-a"
   },
   "note": "nor marked as running",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.upsert",
   "payload": {
    "title": "Edited",
    "prompt": "Where is the add function defined?",
    "enabled": true,
    "schedule": {
     "type": "interval",
     "everyMs": 3600000
    },
    "projectId": "$PROJECT",
    "workspaceStrategy": {
     "type": "root"
    },
    "modelSelection": {
     "instanceId": "claudeAgent",
     "model": "claude-haiku-5-5"
    },
    "runtimeMode": "approval-required",
    "interactionMode": "default",
    "id": "task-a"
   },
   "note": "nor saved",
   "expect": "failure",
   "error": "ScheduledTaskError"
  },
  {
   "tag": "scheduledTasks.subscribe",
   "payload": {},
   "note": "nothing changed",
   "expect": "chunk"
  },
  {
   "tag": "scheduledTasks.runNow",
   "payload": {
    "id": "task-a"
   },
   "note": "the run starts but its outcome cannot be written",
   "expect": "failure",
   "error": "ScheduledTaskError",
   "sh": "sqlite3 home/userdata/domovoi.sqlite \"DROP TRIGGER IF EXISTS refuse; CREATE TRIGGER refuse BEFORE UPDATE ON scheduled_tasks WHEN NEW.run_count > OLD.run_count BEGIN SELECT RAISE(ABORT, 'refused by the test'); END\""
  },
  {
   "tag": "scheduledTasks.subscribe",
   "payload": {},
   "note": "the row stays running",
   "expect": "chunk",
   "sleep_ms": 2500
  },
  {
   "tag": "scheduledTasks.delete",
   "payload": {
    "id": "task-a"
   },
   "note": "the row cannot be deleted",
   "expect": "failure",
   "error": "ScheduledTaskError",
   "sh": "sqlite3 home/userdata/domovoi.sqlite \"DROP TRIGGER IF EXISTS refuse; CREATE TRIGGER refuse BEFORE DELETE ON scheduled_tasks  BEGIN SELECT RAISE(ABORT, 'refused by the test'); END\""
  },
  {
   "tag": "scheduledTasks.setEnabled",
   "payload": {
    "id": "hook-a",
    "enabled": false
   },
   "note": "a write that changes no row (as when the row went meanwhile): the task is gone",
   "expect": "failure",
   "error": "ScheduledTaskError",
   "sh": "sqlite3 home/userdata/domovoi.sqlite \"DROP TRIGGER IF EXISTS refuse; CREATE TRIGGER refuse BEFORE UPDATE ON scheduled_tasks BEGIN SELECT RAISE(IGNORE); END\""
  },
  {
   "tag": "scheduledTasks.rotateWebhookToken",
   "payload": {
    "id": "hook-a"
