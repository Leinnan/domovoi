#!/bin/bash
# Says how the stand-in `gh` of the `prs-*` RPC groups misbehaves from now on
# (see `gh` beside this file). Each call replaces the rules before it:
#   gh-rule clear
#   gh-rule <err|out|sleep> '<extended regex>' '<text>' [<kind> '<regex>' '<text>' ...]
D="$(cd "$(dirname "$0")/.." && pwd)/gh-data"
: > "$D/rules"
[ "$1" = "clear" ] && exit 0
while [ $# -ge 3 ]; do
  printf '%s\t%s\t%s\n' "$2" "$1" "$3" >> "$D/rules"
  shift 3
done
