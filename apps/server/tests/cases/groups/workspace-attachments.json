{
  "normalize": [["/api/assets/attachment/[A-Za-z0-9_.-]+", "/api/assets/attachment/<signed>"]],
  "cases": [
    { "tag": "attachments.createUploadUrl", "payload": { "name": "shot.png", "mimeType": "image/png", "sizeBytes": 7 }, "save": { "IMG": "/attachmentId", "IMGURL": "/relativeUrl" }, "note": "an image, the type left out" },
    { "http": "POST $IMGURL", "payload": { "a": 12 }, "status": 400, "note": "8 bytes where 7 were announced" },
    { "http": "POST $IMGURL", "payload": { "a": 1 }, "status": 204 },
    { "http": "POST $IMGURL", "payload": { "a": 1 }, "status": 204, "note": "the same bytes again" },
    { "http": "POST $IMGURL", "payload": { "a": 2 }, "status": 409, "note": "other bytes for the same id" },
    { "http": "POST $IMGURLx", "payload": { "a": 1 }, "status": 404, "note": "a changed token" },
    { "http": "POST /api/attachments/upload/nonsense", "payload": { "a": 1 }, "status": 404 },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "image", "name": "photo.JPG", "mimeType": "image/jpeg", "sizeBytes": 1024 } },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "notes.txt", "mimeType": "text/plain", "sizeBytes": 16 }, "save": { "FILE": "/attachmentId", "FILEURL": "/relativeUrl" } },
    { "http": "POST $FILEURL", "payload": { "note": "hello" }, "status": 204 },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "diagram", "mimeType": "image/svg+xml", "sizeBytes": 5 }, "note": "an SVG sent as a file is named .svg" },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "archive.tar.GZ", "mimeType": "application/gzip", "sizeBytes": 5 } },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "noext", "mimeType": "application/octet-stream", "sizeBytes": 5 } },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "file", "name": "draft.part", "mimeType": "application/octet-stream", "sizeBytes": 5 } },
    { "tag": "attachments.createUploadUrl", "payload": {}, "note": "a request outside the schema, on purpose: every field has a fallback" },
    { "tag": "attachments.createUploadUrl", "payload": { "type": 5, "name": 7, "mimeType": null, "sizeBytes": "big" }, "note": "a request outside the schema, on purpose: a field not of its type reads as left out" },
    { "tag": "attachments.createUploadUrl", "payload": ["file", "notes.txt", "text/plain", 16], "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "attachments.createUploadUrl", "payload": true, "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "attachments.createUploadUrl", "payload": { "type": "video", "name": "clip.mp4", "mimeType": "video/mp4", "sizeBytes": 9 }, "note": "a request outside the schema, on purpose: an unknown type is kept as an image is" },

    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$FILE" } }, "save": { "ASSET": "/relativeUrl" } },
    { "http": "GET $ASSET", "status": 200, "note": "the uploaded bytes" },
    { "http": "GET $ASSET", "anonymous": true, "status": 200, "note": "the token is the credential" },
    { "http": "GET $ASSETx", "status": 404, "note": "a changed token" },
    { "http": "GET /api/assets/attachment/nonsense", "status": 404 },
    { "http": "GET /api/assets/none/project-favicon-missing", "status": 404, "note": "where a favicon's URL leads" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$IMG", "fileName": "shot.png", "mimeType": "image/png", "disposition": "inline" } }, "save": { "IMGASSET": "/relativeUrl" } },
    { "http": "GET $IMGASSET", "status": 200 },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "missing" } }, "expect": "failure", "error": "AssetUrlError", "note": "the unchanged server answers with `AssetUrlError`, a tag t3code's `AssetAccessError` does not have" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "../$FILE" } }, "expect": "failure", "error": "AssetUrlError", "note": "the unchanged server answers with `AssetUrlError`, a tag t3code's `AssetAccessError` does not have: an id is no path" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment" } }, "expect": "failure", "error": "AssetUrlError", "note": "the unchanged server answers with `AssetUrlError`, a tag t3code's `AssetAccessError` does not have; also a request outside the schema, on purpose: no id reads as an empty one" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "project-favicon", "cwd": "$WORKSPACE" } }, "note": "no favicons: a URL that answers 404" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "draft-workspace-file", "cwd": "$WORKSPACE", "path": "calc.py" } } },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "workspace-file", "threadId": "thread-1", "path": "calc.py" } } },
    { "tag": "assets.createUrl", "payload": { "resource": ["attachment", "$FILE"] }, "note": "a request outside the schema, on purpose: a resource that is no record names no attachment" },
    { "tag": "assets.createUrl", "payload": { "resource": "attachment" }, "note": "a request outside the schema, on purpose" },
    { "tag": "assets.createUrl", "payload": [{ "_tag": "attachment", "attachmentId": "$FILE" }], "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "assets.createUrl", "payload": {}, "note": "a request outside the schema, on purpose: anything that names no attachment gets the favicon URL" },

    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m2", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "save": { "KEPT": "/attachments/0/id" } },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m2", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "note": "again: the same id" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "Thread 2!", "messageId": "m3", "attachments": [
        { "type": "image", "name": "b.jpeg", "mimeType": "image/jpeg", "sizeBytes": 3, "dataUrl": "data:image/jpeg;base64,AQID" },
        { "type": "image", "name": "c", "mimeType": "image/gif", "sizeBytes": 2, "dataUrl": "data:image/gif;base64,AQI=" },
        { "type": "image", "name": "d.webp", "mimeType": "image/WEBP", "sizeBytes": 1, "dataUrl": "data:IMAGE/webp;base64, AQ== " },
        { "type": "image", "name": "e.ico", "mimeType": "image/x-icon", "sizeBytes": 1, "dataUrl": "data:image/x-icon;base64,AQ==" },
        { "type": "image", "name": "f", "mimeType": "image/x-unknown", "sizeBytes": 0, "dataUrl": "data:image/x-unknown;base64," },
        { "type": "image", "name": "window.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID",
          "source": { "kind": "snap-shot", "capturedAt": "2025-03-10T09:00:00.000Z", "appName": "Notes", "windowTitle": "Shopping list", "accessibleText": "Milk, eggs",
            "accessibility": { "format": "element-tree", "coordinateSpace": "captured-image", "imageSize": { "width": 800, "height": 600 }, "truncated": false,
              "root": { "role": "window", "name": "Shopping list", "bounds": { "x": 0, "y": 0, "width": 800, "height": 600 }, "state": { "focused": true, "checked": "mixed" }, "actions": ["press"],
                "children": [{ "role": "text", "value": "Milk, eggs", "description": "the list", "bounds": null, "children": [] }] } },
            "appIdentifier": "com.example.notes", "appIconDataUrl": "data:image/png;base64,AQID" } },
        { "type": "image", "name": "flat.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID",
          "source": { "kind": "snap-shot", "capturedAt": "2025-03-10T09:00:00.000Z", "appName": "Notes", "windowTitle": "", "accessibility": { "format": "flat-text", "text": "Milk", "truncated": true } } }
      ] }, "note": "several, each with the extension of its type; where an image came from is kept" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "pending", "messageId": "m4", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "note": "a thread named like the pending folder" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m5", "attachments": [] }, "note": "none" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m6", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "nonsense" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "no data URL" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m6", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/jpeg;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "the data URL is of another type" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m6", "attachments": [{ "type": "image", "name": "a.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "not base64" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m6", "attachments": [{ "type": "image", "name": "b.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,@@@@" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "invalid base64" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m6", "attachments": [{ "type": "image", "name": "c.png", "mimeType": "image/png", "sizeBytes": 9, "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "the size is another" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "!!!", "messageId": "m6", "attachments": [{ "type": "image", "name": "d.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "a thread id with nothing to name a file by" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m7", "attachments": [
        { "type": "image", "name": "ok.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" },
        { "type": "image", "name": "bad.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQ==" } ] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "the second of two fails" },
    { "tag": "assets.persistChatAttachments", "payload": ["thread-1", "m8", []], "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "assets.persistChatAttachments", "payload": 5, "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m8", "attachments": [["a.png", "image/png", 3, "data:image/png;base64,AQID"]] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "a request outside the schema, on purpose: an attachment that is a list has every fallback" },
    { "tag": "assets.persistChatAttachments", "payload": {}, "note": "a request outside the schema, on purpose: no list reads as an empty one" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m8", "attachments": "none" }, "note": "a request outside the schema, on purpose" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m8", "attachments": [5] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "a request outside the schema, on purpose: an attachment that is no record has every fallback" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m8", "attachments": [{ "mimeType": "image/png", "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "a request outside the schema, on purpose: without a size none matches" },
    { "tag": "assets.persistChatAttachments", "payload": { "messageId": 9, "attachments": [{ "name": 7, "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID", "source": null }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "a request outside the schema, on purpose: no thread id reads as an empty one" },
    { "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "attachments": [{ "name": 7, "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID", "source": null }] }, "note": "a request outside the schema, on purpose: a name that is no text reads as `attachment`, a null source as none" },

    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$KEPT" } }, "note": "a persisted attachment" },
    { "tag": "attachments.delete", "payload": { "attachmentId": "$KEPT" }, "note": "only pending uploads are deleted" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$KEPT" } }, "note": "still there" },
    { "tag": "attachments.delete", "payload": { "attachmentId": "$FILE" } },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$FILE" } }, "expect": "failure", "error": "AssetUrlError", "note": "the unchanged server answers with `AssetUrlError`, a tag t3code's `AssetAccessError` does not have: deleted" },
    { "http": "GET $ASSET", "status": 404, "note": "the URL of a deleted attachment" },
    { "tag": "attachments.delete", "payload": { "attachmentId": "$FILE" }, "note": "again: nothing to do" },
    { "tag": "attachments.delete", "payload": { "attachmentId": "pending-../../x" } },
    { "tag": "attachments.delete", "payload": ["$IMG"], "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$IMG" } }, "note": "not deleted by it" },
    { "tag": "attachments.delete", "payload": {}, "note": "a request outside the schema, on purpose" },

    { "sh": "mv home/userdata/attachments home/userdata/attachments-aside; touch home/userdata/attachments", "tag": "assets.persistChatAttachments", "payload": { "threadId": "thread-1", "messageId": "m9", "attachments": [{ "type": "image", "name": "e.png", "mimeType": "image/png", "sizeBytes": 3, "dataUrl": "data:image/png;base64,AQID" }] }, "expect": "failure", "error": "PersistChatAttachmentsError", "note": "the file cannot be written" },
    { "sh": "rm home/userdata/attachments; mv home/userdata/attachments-aside home/userdata/attachments; rm home/userdata/attachment-signing-key; mkdir home/userdata/attachment-signing-key", "tag": "attachments.createUploadUrl", "payload": { "name": "shot.png", "mimeType": "image/png", "sizeBytes": 7 }, "expect": "failure", "error": "AttachmentUploadSigningKeyError", "note": "no signing key can be read or written" },
    { "tag": "assets.createUrl", "payload": { "resource": { "_tag": "attachment", "attachmentId": "$KEPT" } }, "expect": "failure", "error": "AssetUrlError", "note": "the unchanged server answers with `AssetUrlError`, a tag t3code's `AssetAccessError` does not have: no signing key" },
    { "http": "GET $IMGASSET", "status": 404, "note": "no signing key to check the token with" },
    { "sh": "rmdir home/userdata/attachment-signing-key", "tag": "attachments.createUploadUrl", "payload": { "name": "shot.png", "mimeType": "image/png", "sizeBytes": 7 }, "note": "a new key" },
    { "http": "GET $IMGASSET", "status": 404, "note": "signed with the old key" }
  ]
}
