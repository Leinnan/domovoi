{
  "env": { "GIT_AUTHOR_DATE": "2024-01-02T03:04:05Z", "GIT_COMMITTER_DATE": "2024-01-02T03:04:05Z",
           "DOMOVOI_CODEX_BINARY": "$DIR/bin/broken-codex", "DOMOVOI_CLAUDE_BINARY": "$DIR/bin/no-claude" },
  "cases": [
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "7" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": " #7 " }, "note": "a reference with spaces around it, which the schema does not allow, is trimmed" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "#7" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "https://github.com/acme/widgets/pull/7" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "8" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "9" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "10" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "11" } },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "17" }, "note": "gh answered with a number only: the empty title and branches are outside the schema" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "18" }, "expect": "failure", "error": "SourceControlProviderError", "note": "gh answered with something that is not JSON" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "404" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "sh": "echo 'To get started with GitHub CLI, please run:  gh auth login' > gh/fail",
      "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "sh": "printf '\\n\\n' > gh/fail",
      "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/local", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError", "note": "gh failed and said nothing" },
    { "sh": "rm gh/fail",
      "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/notrepo", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/missing", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/noremote", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/gitlab", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/elsewhere", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError", "note": "a remote that names no host" },

    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/notrepo", "reference": "7", "mode": "local" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/gitlab", "reference": "#7", "mode": "worktree" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/local", "reference": "404", "mode": "local" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/dirty", "reference": "7", "mode": "local" }, "expect": "failure", "error": "GitManagerError" },
    { "sh": "echo 'error: could not check out the pull request' > gh/checkout-fail",
      "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/local", "reference": "#7", "mode": "local" }, "expect": "failure", "error": "SourceControlProviderError" },
    { "sh": "rm gh/checkout-fail",
      "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/local", "reference": "#7", "mode": "local" } },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/local", "reference": "8", "mode": "local" }, "note": "the checkout is not at the head gh named" },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/local", "localOnly": true } },

    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "7", "mode": "worktree" } },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "7", "mode": "worktree" }, "note": "again: the worktree is reused" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "8", "mode": "worktree" }, "note": "from a fork: a branch name of its own" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "14", "mode": "somewhere" }, "note": "a mode outside the schema, still answered: anything but local is a worktree" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "13", "mode": "worktree" }, "expect": "failure", "error": "GitPullRequestMaterializationError" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "16", "mode": "worktree" }, "expect": "failure", "error": "GitPullRequestMaterializationError" },
    { "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "15", "mode": "worktree" }, "expect": "failure", "error": "GitCommandError", "note": "its branch is checked out here already" },
    { "tag": "server.updateSettings", "payload": { "patch": { "worktreesDirectory": "$DIR/custom/worktrees" } } },
    { "sh": "git -C repos/trees worktree prune && rm -rf home/worktrees/trees && git -C repos/trees worktree prune",
      "tag": "git.preparePullRequestThread", "payload": { "cwd": "$DIR/repos/trees", "reference": "7", "mode": "worktree" }, "note": "the branch is there, its worktree is not: in the folder the settings name" },
    { "tag": "vcs.listRefs", "payload": { "cwd": "$DIR/repos/trees" } },

    { "tag": "git.runStackedAction", "payload": { "actionId": "a1", "cwd": "$DIR/repos/noremote", "action": "commit" }, "all": true, "expect": "failure", "error": "TextGenerationError", "note": "the Codex CLI does not start" },
    { "tag": "server.updateSettings", "payload": { "patch": { "textGenerationModelSelection": { "instanceId": "claudeAgent", "model": "claude-haiku-5-5" } } } },
    { "tag": "git.runStackedAction", "payload": { "actionId": "a2", "cwd": "$DIR/repos/noremote", "action": "commit" }, "all": true, "expect": "failure", "error": "TextGenerationError", "note": "the Claude CLI is not there" },
    { "tag": "server.updateSettings", "payload": { "patch": { "textGenerationModelSelection": { "instanceId": "opencode", "model": "fake/m1" } } } },
    { "tag": "git.runStackedAction", "payload": { "actionId": "a3", "cwd": "$DIR/repos/noremote", "action": "commit" }, "all": true, "expect": "failure", "error": "TextGenerationError", "note": "a provider that writes no text here" },
    { "tag": "server.updateSettings", "payload": { "patch": { "textGenerationModelSelection": { "instanceId": "codex", "model": "" } } }, "note": "a model selection with no model, which the schema does not allow" },
    { "tag": "git.runStackedAction", "payload": { "actionId": "a4", "cwd": "$DIR/repos/noremote", "action": "commit" }, "all": true, "expect": "failure", "error": "TextGenerationError", "note": "no model" }
  ]
}
