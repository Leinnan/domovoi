{
  "env": { "SHELL": "$DIR/bin/fakeshell" },
  "cases": [
    { "tag": "subscribeTerminalMetadata", "payload": {}, "expect": "chunk", "note": "no terminals yet" },
    { "tag": "terminal.open", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work" }, "note": "a new terminal: nothing printed yet" },
    { "sleep_ms": 1500, "tag": "terminal.open", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/elsewhere", "env": { "IGNORED": "1" } }, "note": "open already: the terminal as it is, with what its shell printed" },
    { "tag": "terminal.attach", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work", "cols": 80, "rows": 24 }, "expect": "chunk", "note": "the snapshot first" },
    { "tag": "terminal.observe", "payload": { "threadId": "thread-a", "terminalId": "term-1" }, "expect": "chunk" },
    { "tag": "subscribeTerminalMetadata", "payload": {}, "expect": "chunk", "note": "one terminal" },
    { "tag": "terminal.write", "payload": { "threadId": "thread-a", "terminalId": "term-1", "data": "hello there\n" } },
    { "sleep_ms": 800, "tag": "terminal.open", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work" }, "note": "the answer is in the history" },
    { "tag": "terminal.resize", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cols": 100, "rows": 40 } },
    { "tag": "terminal.resize", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cols": 100, "rows": 40 }, "note": "the same size again: no event" },
    { "tag": "terminal.write", "payload": { "threadId": "thread-a", "terminalId": "term-1", "data": "size\n" } },
    { "sleep_ms": 800, "tag": "terminal.observe", "payload": { "threadId": "thread-a", "terminalId": "term-1" }, "expect": "chunk", "note": "resized: the new grid, one event more" },
    { "tag": "terminal.clear", "payload": { "threadId": "thread-a", "terminalId": "term-1" } },
    { "tag": "terminal.open", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work" }, "note": "cleared: no history" },
    { "tag": "terminal.write", "payload": { "threadId": "thread-a", "terminalId": "term-1", "data": "exit\n" } },
    { "sleep_ms": 1200, "tag": "terminal.open", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work" }, "note": "the shell ended: exited, with its code" },
    { "tag": "terminal.attach", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cwd": "$DIR/work" }, "expect": "chunk", "note": "an exited terminal is still there" },
    { "tag": "subscribeTerminalMetadata", "payload": { "anything": 1 }, "expect": "chunk", "note": "an exited terminal in the list; the payload is not read" },
    { "tag": "subscribeTerminalMetadata", "payload": "anything", "expect": "chunk", "note": "the payload is not read" },
    { "tag": "terminal.clear", "payload": { "threadId": "thread-a", "terminalId": "term-1" }, "note": "an exited terminal can be cleared" },
    { "tag": "terminal.resize", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cols": 90, "rows": 20 }, "note": "and resized" },
    { "tag": "terminal.close", "payload": { "threadId": "thread-a", "terminalId": "term-1" } },
    { "tag": "terminal.close", "payload": { "threadId": "thread-a", "terminalId": "term-1", "deleteHistory": true }, "note": "closed already: nothing to do" },
    { "tag": "terminal.close", "payload": { "threadId": "thread-a", "terminalId": "never-opened" } },
    { "tag": "subscribeTerminalMetadata", "payload": {}, "expect": "chunk", "note": "none again" },
    { "tag": "terminal.observe", "payload": { "threadId": "thread-a", "terminalId": "term-1" }, "expect": "failure", "error": "TerminalSessionLookupError" },
    { "tag": "terminal.write", "payload": { "threadId": "thread-a", "terminalId": "term-1", "data": "x" }, "expect": "failure", "error": "TerminalSessionLookupError" },
    { "tag": "terminal.resize", "payload": { "threadId": "thread-a", "terminalId": "term-1", "cols": 80, "rows": 24 }, "expect": "failure", "error": "TerminalSessionLookupError" },
    { "tag": "terminal.clear", "payload": { "threadId": "thread-a", "terminalId": "term-1" }, "expect": "failure", "error": "TerminalSessionLookupError" },
    { "tag": "terminal.observe", "payload": { "threadId": "other-thread", "terminalId": "term-1" }, "expect": "failure", "error": "TerminalSessionLookupError", "note": "a terminal belongs to its thread" },

    { "tag": "terminal.attach", "payload": { "threadId": "thread-b", "terminalId": "scripts", "cwd": "$DIR/missing-folder", "env": { "GREETING": "hi there", "TERM": "dumb" } }, "expect": "chunk", "note": "attach opens a terminal; its label is its id" },
    { "sleep_ms": 1500, "tag": "terminal.open", "payload": { "threadId": "thread-b", "terminalId": "scripts", "cwd": "$DIR/work" }, "note": "the environment given, and the home folder where the cwd is missing" },
    { "tag": "terminal.open", "payload": { "threadId": "thread-b", "terminalId": "term-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "cwd": "$DIR/work" }, "note": "a request outside the schema, on purpose: an id too long for a label" },
    { "tag": "terminal.close", "payload": { "threadId": "thread-b", "terminalId": "term-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "note": "a request outside the schema, on purpose" },
    { "tag": "terminal.close", "payload": { "threadId": "thread-b", "terminalId": "scripts" } },
    { "tag": "terminal.observe", "payload": { "threadId": "thread-b", "terminalId": "scripts" }, "expect": "failure", "error": "TerminalSessionLookupError" }
  ]
}
