{
  "cases": [
    { "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "no clone yet" },
    { "tag": "projectClone.start", "payload": { "projectId": "pc-ssh", "title": "By URL", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "git@github.test:acme/local.git", "destinationPath": "$DIR/clones/p-ssh" }, "note": "a URL alone: no repository in the answer" },
    { "sh": "await-done pc-ssh", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "the clone is done" },
    { "http": "GET /api/orchestration/shell", "status": 200, "note": "the project the clone made, with the repository it is of" },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "c-taken", "projectId": "existing-1", "title": "Already here", "workspaceRoot": "$DIR/clones/p-taken", "createWorkspaceRootIfMissing": true, "defaultModelSelection": null }, "note": "a project on the folder the next clone goes to" },
    { "tag": "projectClone.start", "payload": { "projectId": "pc-other", "title": "Not used", "createdAt": "2026-01-01T00:00:00.000Z", "remoteUrl": "ssh://git@github.test/acme/local.git", "protocol": "ssh", "destinationPath": "$DIR/clones/p-taken" }, "note": "the project on that folder takes the clone: the answer names it" },
    { "sh": "await-done existing-1", "tag": "subscribeProjectClones", "payload": {}, "expect": "chunk", "note": "both are done" },
    { "http": "GET /api/orchestration/shell", "status": 200, "note": "no project was made for the second clone; the one that took it has its repository now" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pc-ssh" }, "note": "a clone that is done is not cancelled" },
    { "tag": "projectClone.retry", "payload": { "projectId": "pc-ssh" }, "note": "a clone that is done is not retried" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "nope" }, "note": "no such clone" },
    { "tag": "projectClone.retry", "payload": { "projectId": "nope" }, "note": "no such clone" },
    { "tag": "projectClone.cancel", "payload": { "projectId": "pc-other" }, "note": "the clone is the other project's now" },
    { "tag": "subscribeProjectClones", "payload": "anything", "expect": "chunk", "note": "the payload is outside the schema on purpose: the server does not read it" }
  ]
}
