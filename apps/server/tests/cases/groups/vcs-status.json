{
  "env": { "GIT_AUTHOR_DATE": "2024-01-02T03:04:05Z", "GIT_COMMITTER_DATE": "2024-01-02T03:04:05Z" },
  "normalize": [["git version [0-9][^\"]*", "git version <version>"]],
  "cases": [
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/notrepo" }, "note": "outside a repository: no upstream, neither ahead nor behind, no pull request" },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/notrepo", "localOnly": true } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/missing" }, "note": "as outside a repository" },
    { "tag": "vcs.refreshStatus", "payload": {}, "note": "no cwd is an empty one: as outside a repository" },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/empty" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/unborn" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/clean" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/clean", "localOnly": true } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/clean", "localOnly": "yes" }, "note": "a payload outside the schema, still answered: anything but true is false" },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/dirty" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/dirty/sub" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/staged" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/detached" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/tracking" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/tracking", "localOnly": true } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/feature" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/pushed" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/gitlab" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/bitbucket" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/selfhosted" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/local" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/fork" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/master" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/trunk" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/conflict" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/trees" } },
    { "tag": "vcs.refreshStatus", "payload": { "cwd": "$DIR/repos/trees-side" } },

    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/notrepo" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/empty" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/unborn" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/clean" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/dirty" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/detached" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/tracking" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/pushed" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/gitlab" }, "expect": "chunk" },
    { "tag": "subscribeVcsStatus", "payload": { "cwd": "$DIR/repos/conflict" }, "expect": "chunk" },

    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/notrepo" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/missing" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/empty" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/clean" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/detached" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/feature" }, "expect": "chunk" },
    { "tag": "subscribeVcsBranch", "payload": { "cwd": "$DIR/repos/trees-side" }, "expect": "chunk" },

    { "tag": "server.discoverSourceControl", "payload": {}, "note": "neither gh nor jj is installed" },
    { "tag": "git.resolvePullRequest", "payload": { "cwd": "$DIR/repos/tracking", "reference": "7" }, "expect": "failure", "error": "SourceControlProviderError", "note": "gh is not installed" },

    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-0", "projectId": "project-tracking", "title": "tracking", "workspaceRoot": "$DIR/repos/tracking", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-1", "projectId": "project-gitlab", "title": "gitlab", "workspaceRoot": "$DIR/repos/gitlab", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-2", "projectId": "project-bitbucket", "title": "bitbucket", "workspaceRoot": "$DIR/repos/bitbucket", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-3", "projectId": "project-selfhosted", "title": "selfhosted", "workspaceRoot": "$DIR/repos/selfhosted", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-4", "projectId": "project-local", "title": "local", "workspaceRoot": "$DIR/repos/local", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-5", "projectId": "project-fork", "title": "fork", "workspaceRoot": "$DIR/repos/fork", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-6", "projectId": "project-clean", "title": "clean", "workspaceRoot": "$DIR/repos/clean", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "projects.mutate", "payload": { "type": "project.create", "commandId": "identity-7", "projectId": "project-notrepo", "title": "notrepo", "workspaceRoot": "$DIR/repos/notrepo", "createWorkspaceRootIfMissing": false, "defaultModelSelection": null } },
    { "tag": "orchestration.subscribeShell", "payload": {}, "expect": "chunk", "note": "each project with the repository identity read from its remote" }
  ]
}
