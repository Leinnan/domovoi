#!/bin/bash
# Says how the stand-in `glab` of the `*-gitlab*` RPC groups misbehaves from now on
# (see `glab` beside this file). Each call replaces the rules before it:
#   glab-rule clear
#   glab-rule <err|out> '<extended regex>' '<text>' [<kind> '<regex>' '<text>' ...]
D="$(cd "$(dirname "$0")/.." && pwd)/glab-data"
: > "$D/rules"
[ "$1" = "clear" ] && exit 0
while [ $# -ge 3 ]; do
  printf '%s\t%s\t%s\n' "$2" "$1" "$3" >> "$D/rules"
  shift 3
done
