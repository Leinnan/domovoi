    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree" }, "note": "the whole tree, ignored entries left out, sorted" },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "" }, "note": "the root's children: ignored ones marked, symlinks out of the root and loops left out" },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "src" } },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "/src/nested/" } },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "build" }, "note": "inside an ignored folder" },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "link-dir" }, "note": "through a symlink that stays inside" },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "src/nested/deep/more" } },
