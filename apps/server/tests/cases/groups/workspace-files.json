    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree", "query": "", "limit": 50, "imageOnly": true } },
    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree", "query": "png", "limit": 50, "kind": "directory", "imageOnly": true }, "note": "imageOnly wins over kind" },
    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree", "query": "", "limit": 200 }, "note": "an empty query lists the index" },
    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree", "query": "", "limit": 2, "imageOnly": false }, "note": "cut at the limit" },
