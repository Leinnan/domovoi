    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree/README.md" }, "expect": "failure", "error": "ProjectListEntriesError", "note": "workspace_root_not_directory" },
    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree/README.md/below" }, "expect": "failure", "error": "ProjectListEntriesError", "note": "workspace_root_stat_failed" },
