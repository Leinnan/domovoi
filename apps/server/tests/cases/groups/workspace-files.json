    { "tag": "filesystem.getMetadata", "payload": ["$DIR/tree"], "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "filesystem.getMetadata", "payload": 7, "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
    { "tag": "filesystem.browse", "payload": { "partialPath": "$DIR/tree/" }, "note": "folders only, hidden ones left out" },
