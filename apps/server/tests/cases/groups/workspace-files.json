    { "tag": "projects.writeFile", "payload": { "cwd": "$DIR/tree", "relativePath": "", "contents": "x" }, "expect": "failure", "error": "ProjectWriteFileError", "note": "a request outside the schema, on purpose: an empty path is refused by the handler" },
    { "tag": "projects.writeFile", "payload": { "cwd": "$DIR/tree", "relativePath": "link-out/x.txt", "contents": "x" }, "expect": "failure", "error": "ProjectWriteFileError", "note": "resolved_path_outside_root" },
