    { "tag": "projects.searchContents", "payload": { "cwd": "$DIR/tree/README.md", "query": "x", "limit": 5, "caseSensitive": false, "wholeWord": false, "useRegex": false }, "expect": "failure", "error": "ProjectSearchContentsError" },
    { "tag": "projects.searchContents", "payload": { "cwd": "$DIR/tree/README.md/below", "query": "x", "limit": 5, "caseSensitive": false, "wholeWord": false, "useRegex": true }, "expect": "failure", "error": "ProjectSearchContentsError" },

