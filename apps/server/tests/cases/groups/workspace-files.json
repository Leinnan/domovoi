    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree/README.md", "query": "", "limit": 5 }, "expect": "failure", "error": "ProjectSearchEntriesError", "note": "workspace_root_not_directory" },
    { "tag": "projects.searchEntries", "payload": { "cwd": "$DIR/tree/README.md/below", "query": "x", "limit": 7 }, "expect": "failure", "error": "ProjectSearchEntriesError", "note": "workspace_root_stat_failed" },

    { "tag": "projects.searchContents", "payload": { "cwd": "$DIR/tree", "query": "add", "limit": 50, "caseSensitive": false, "wholeWord": false, "useRegex": false }, "note": "ranges count UTF-16 units; ignored files are not searched" },
