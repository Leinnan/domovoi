    { "tag": "filesystem.getMetadata", "payload": { "paths": ["$DIR/tree/README.md", "$DIR/tree", "$DIR/tree/blob", "$DIR/tree/paper", "$DIR/tree/words", "$DIR/tree/empty", "$DIR/tree/logo.PNG", "$DIR/tree/link-file", "$DIR/tree/link-dir", "$DIR/tree/link-broken", "$DIR/outside/pipe", "relative.txt", "$DIR/missing", "//server/share", "~/notes.txt", "/HOME/notes.txt", "$DIR/home", "$DIR/home/userdata"] }, "note": "in request order; null for a path that is relative, missing or the server's own" },
