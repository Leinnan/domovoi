    { "tag": "projects.searchContents", "payload": { "cwd": "$DIR/tree", "query": "zzzzqqqq", "limit": 50, "caseSensitive": false, "wholeWord": false, "useRegex": false }, "note": "nothing matches" },
    { "tag": "projects.searchContents", "payload": { "cwd": "$DIR/plain", "query": "plain", "limit": 50, "caseSensitive": false, "wholeWord": false, "useRegex": false } },
