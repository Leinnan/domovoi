    { "tag": "projects.listEntries", "payload": { "cwd": "$DIR/tree", "directoryPath": "README.md" }, "expect": "failure", "error": "ProjectListEntriesError", "note": "directory_list_failed: a file" },

    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/tree" } },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/plain" }, "note": "no repository: none" },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/ignored-many" }, "note": "more than the 200 the list holds" },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/missing" }, "expect": "failure", "error": "ProjectListEntriesError" },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/tree/README.md" }, "expect": "failure", "error": "ProjectListEntriesError" },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": "$DIR/tree/README.md/below" }, "expect": "failure", "error": "ProjectListEntriesError" },
    { "tag": "projects.listIgnoredFiles", "payload": {}, "expect": "failure", "error": "ProjectListEntriesError", "note": "a request outside the schema, on purpose: without a cwd the handler goes on with an empty one" },
    { "tag": "projects.listIgnoredFiles", "payload": { "cwd": 7 }, "expect": "failure", "error": "ProjectListEntriesError", "note": "a request outside the schema, on purpose: a cwd that is no text reads as empty" },

    { "tag": "projects.listIgnoredFiles", "payload": ["$DIR/tree"], "expect": "failure", "error": "ProjectListEntriesError", "note": "a request outside the schema, on purpose: a payload that is no record reads as one with nothing in it" },
