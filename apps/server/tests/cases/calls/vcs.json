[
  { "tag": "vcs.refreshStatus", "payload": { "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "vcs.refreshStatus", "payload": { "cwd": "$WORKSPACE", "localOnly": true }, "expect": "success" },
  { "tag": "vcs.createRef", "payload": { "cwd": "$WORKSPACE", "refName": "feature/calc" }, "expect": "success" },
  { "tag": "vcs.createRef", "payload": { "cwd": "$WORKSPACE", "refName": "feature/calc" }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "vcs.switchRef", "payload": { "cwd": "$WORKSPACE", "refName": "feature/calc" }, "expect": "success" },
  { "tag": "vcs.switchRef", "payload": { "cwd": "$WORKSPACE", "refName": "main" }, "expect": "success" },
  { "tag": "vcs.switchRef", "payload": { "cwd": "$WORKSPACE", "refName": "no-such-branch" }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "vcs.createWorktree", "payload": { "cwd": "$WORKSPACE", "refName": "main", "newRefName": "wt/one", "path": null }, "expect": "success" },
  { "tag": "vcs.createWorktree", "payload": { "cwd": "$WORKSPACE", "refName": "nope", "path": null }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "vcs.removeWorktree", "payload": { "cwd": "$WORKSPACE", "path": "/definitely/not/a/worktree" }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "vcs.pull", "payload": { "cwd": "$WORKSPACE" }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "vcs.init", "payload": { "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "vcs.init", "payload": { "cwd": "/definitely/missing" }, "expect": "failure", "error": "VcsProcessSpawnError" },
  { "tag": "review.getDiffPreview", "payload": { "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "review.getDiffPreview", "payload": { "cwd": "$WORKSPACE", "sourceKind": "working-tree", "metadataOnly": true }, "expect": "success" },
  { "tag": "review.getDiffPreview", "payload": { "cwd": "$WORKSPACE", "commitSha": "HEAD" }, "expect": "success" },
  { "tag": "review.getDiffPreview", "payload": { "cwd": "/tmp" }, "expect": "success" },
  { "tag": "review.getDiffFileContents", "payload": { "cwd": "$WORKSPACE", "sourceKind": "working-tree", "changeType": "change", "baseRef": null, "headRef": null, "oldPath": "calc.py", "newPath": "calc.py" }, "expect": "success" },
  { "tag": "review.getDiffFileContents", "payload": { "cwd": "$WORKSPACE", "sourceKind": "working-tree", "changeType": "change", "baseRef": null, "headRef": null, "oldPath": "calc.py", "newPath": "../outside" }, "expect": "failure", "error": "GitCommandError" },
  { "tag": "orchestration.launchThread", "payload": { "commandId": "wt-launch", "creationSource": "web", "threadId": "thread-wt", "projectId": "$PROJECT", "title": "In a worktree",
      "modelSelection": { "instanceId": "claudeAgent", "model": "claude-haiku-5-5" }, "runtimeMode": "approval-required", "interactionMode": "default",
      "workspaceStrategy": { "type": "worktree", "baseRef": "main" }, "initialMessage": { "messageId": "wt-m1", "text": "hello", "attachments": [] } }, "expect": "success" },
  { "tag": "subscribeWorktreeSetup", "payload": { "threadId": "thread-wt" }, "expect": "chunk" },
  { "tag": "subscribeWorktreeSetup", "payload": { "threadId": "nope" }, "expect": "chunk" },
  { "tag": "worktreeSetup.cancel", "payload": { "threadId": "thread-wt" }, "expect": "success" },
  { "tag": "terminal.observe", "payload": { "threadId": "$THREAD", "terminalId": "missing" }, "expect": "failure", "error": "TerminalSessionLookupError" },
  { "tag": "terminal.open", "payload": { "threadId": "$THREAD", "terminalId": "obs", "cwd": "$WORKSPACE" }, "expect": "success" },
  { "tag": "terminal.observe", "payload": { "threadId": "$THREAD", "terminalId": "obs" }, "expect": "chunk" },
  { "tag": "terminal.close", "payload": { "threadId": "$THREAD", "terminalId": "obs" }, "expect": "success" }
