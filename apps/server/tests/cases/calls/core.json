  { "tag": "terminal.clear", "payload": { "threadId": "$THREAD", "terminalId": "core" }, "expect": "success" },
  { "tag": "terminal.write", "payload": { "threadId": "$THREAD", "terminalId": "missing", "data": "x" }, "expect": "failure", "error": "TerminalSessionLookupError" },
