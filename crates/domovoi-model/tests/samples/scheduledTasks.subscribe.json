        "title": "Triage new issues",
        "prompt": "A new issue arrived: {{body.issue.title}}. Label it and reply with a first assessment.",
        "enabled": true,
        "schedule": {
          "type": "webhook",
          "signature": {
            "header": "x-hub-signature-256",
            "encoding": "hex",
            "prefix": "sha256="
          },
          "maxDeliveryAgeMinutes": 90,
          "dedupe": {
            "replayKey": "{{headers.x-github-delivery}}",
            "coalesceKey": "{{body.issue.number}}",
            "coalesceWindowSeconds": 300
          },
          "filters": [
            {
              "path": "headers.x-github-event",
              "op": "equals",
              "value": "issues"
            },
            {
              "path": "body.action",
              "op": "in",
              "value": [
                "opened",
                "reopened"
              ]
            },
            {
              "path": "body.issue.user.login",
              "op": "notEquals",
              "value": "dependabot[bot]"
            },
            {
              "path": "body.repository.full_name",
              "op": "startsWith",
              "value": "acme/"
            },
            {
              "path": "body.issue.labels[]",
              "op": "exists"
            }
          ]
        },
        "projectId": "0e7d6f7b-58a1-4f1e-8d55-9d0a4a7c2b90",
        "threadId": null,
        "threadMode": "new_thread",
